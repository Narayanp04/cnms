# =============================================================================
# ConnectXperts NMS - Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your production values.
# NEVER commit the actual .env file to version control!
# =============================================================================

# --- Application ---
DEBUG=false
APP_NAME=ConnectXperts NMS

# --- Server ---
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=*

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://cnms:YOUR_DB_PASSWORD@postgres:5432/cnms_db
DATABASE_URL_SYNC=postgresql+psycopg2://cnms:YOUR_DB_PASSWORD@postgres:5432/cnms_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# --- Redis ---
REDIS_URL=redis://:YOUR_REDIS_PASS@redis:6379/0
REDIS_CELERY_URL=redis://:YOUR_REDIS_PASS@redis:6379/1

# --- Celery ---
CELERY_BROKER_URL=redis://:YOUR_REDIS_PASS@redis:6379/1
CELERY_RESULT_BACKEND=redis://:YOUR_REDIS_PASS@redis:6379/1

# --- JWT Authentication ---
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Monitoring ---
DEFAULT_POLLING_INTERVAL=30
PING_TIMEOUT=5.0
PING_COUNT=4
PING_THREADS=50
MAX_RETRIES=3
HISTORY_RETENTION_DAYS=365
ALERT_COOLDOWN_SECONDS=300

# --- WhatsApp Cloud API (optional - leave blank if not used) ---
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Email (optional - leave blank if not used) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@cnms.local

# --- Telegram (optional - leave blank if not used) ---
TELEGRAM_BOT_TOKEN=

# --- SLA Settings ---
SLA_TARGET_PERCENTAGE=99.9

# --- Thresholds ---
HIGH_LATENCY_THRESHOLD=150
CRITICAL_LATENCY_THRESHOLD=300
HIGH_PACKET_LOSS_THRESHOLD=5.0
CRITICAL_PACKET_LOSS_THRESHOLD=20.0

# --- Backup ---
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=24

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- CORS ---
# Comma-separated list of allowed origins (your production domain)
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
