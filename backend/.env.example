# ConnectXperts NMS - Environment Variables
# Copy this to .env and update values

# Application
APP_NAME=ConnectXperts NMS
APP_VERSION=1.0.0
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://cnms:cnms123@postgres:5432/cnms_db
DATABASE_URL_SYNC=postgresql+psycopg2://cnms:cnms123@postgres:5432/cnms_db

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CELERY_URL=redis://redis:6379/1

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production-cnms-2024

# Monitoring
PING_TIMEOUT=5.0
PING_COUNT=4
PING_THREADS=50
HISTORY_RETENTION_DAYS=365
ALERT_COOLDOWN_SECONDS=300

# WhatsApp Cloud API
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@cnms.local

# Telegram
TELEGRAM_BOT_TOKEN=

# SLA
SLA_TARGET_PERCENTAGE=99.9

# Backup
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=24
